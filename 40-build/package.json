{
  "name": "aidash",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "AIDash — 多 Agent 协作的交互与决策层（Web + MCP + SQLite + 值守壳）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/the50w/aidash.git"
  },
  "homepage": "https://gitee.com/the50w/aidash",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "cd .. && tsx watch 40-build/10-aidash/src/server/main.ts",
    "start": "cd .. && node 40-build/10-aidash/dist/server/main.js",
    "start:win": "powershell -NoProfile -File 10-aidash/scripts/start-aidash.ps1",
    "build": "tsc -p 00-platform/config/tsconfig.server.json && node 00-platform/tools/copy-server-assets.mjs",
    "typecheck": "tsc -p 00-platform/config/tsconfig.server.json --noEmit && tsc -p 10-aidash/src/web/tsconfig.json --noEmit",
    "web:dev": "pnpm --filter aidash-web dev",
    "web:build": "pnpm --filter aidash-web build",
    "cli:build": "node 00-platform/tools/build-cli.mjs",
    "test": "vitest run --config 00-platform/config/vitest.config.ts",
    "test:watch": "vitest --config 00-platform/config/vitest.config.ts",
    "test:runner": "pnpm --filter aidash-runner test",
    "test:deploy": "node --test \"../60-deliver/scripts/tests/*.test.mjs\"",
    "coverage": "vitest run --config 00-platform/config/vitest.config.ts --coverage",
    "e2e": "node ../50-verify/e2e/run.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:runner && pnpm test:deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
